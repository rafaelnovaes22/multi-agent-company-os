#!/usr/bin/env bash
set -euo pipefail
# bin/test — comando único, parseável, sem credenciais secretas
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
PY="${ROOT}/.venv-uv/bin/python"
if [ ! -x "$PY" ]; then
  PY="python3"
fi
echo "==> bin/test — suíte completa (PY=$PY)"
"$PY" -m compileall -q nucleo
"$PY" -m nucleo.quality.pre_pr_gate
"$PY" -m nucleo.quality.foundry_check
"$PY" -m unittest discover -s tests -v 2>&1 | tee /tmp/nucleo-test.log
echo "==> bin/test OK — log: /tmp/nucleo-test.log"
